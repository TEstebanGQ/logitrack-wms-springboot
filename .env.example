# ==========================================
# LogiTrack S.A. - Plantilla de Variables (.env.example)
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees el archivo .env al repositorio.
# ==========================================

# [OBLIGATORIO] Secreto JWT — generado con: openssl rand -base64 64
# Sin este valor, la aplicación NO arrancará.
JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_DE_AL_MENOS_64_CARACTERES_GENERADO_CON_OPENSSL

# Tiempo de expiración del token JWT en milisegundos (default: 86400000 = 24h)
JWT_EXPIRATION=86400000

# Google OAuth2 — Client ID de tu proyecto en Google Cloud Console
# [H-020 FIX] Este valor NO tiene fallback en código: debe definirse aquí obligatoriamente.
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# [H-004 FIX] Dominios permitidos para CORS (separados por coma, sin espacios)
# En producción configura solo los dominios reales del frontend.
CORS_ALLOWED_ORIGINS=https://app.logitrack.com,https://admin.logitrack.com

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://postgres:5432/logitrack_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
PORT=8081

# Configuración de Correo Gmail (Mailing/SMTP)
# [H-019 FIX] Credenciales completamente anonimizadas para plantilla de configuración
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=usuario_ejemplo@gmail.com
SPRING_MAIL_PASSWORD=tu_app_password_16_caracteres
APP_MAIL_ENABLED=true
APP_MAIL_FROM=no-reply@logitrack.com

