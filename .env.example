# Google OAuth 2.0 Client ID (Reemplaza con tu Client ID real de Google Cloud Console)
GOOGLE_CLIENT_ID=1056581979401-4n88v213h468n4613n89.apps.googleusercontent.com

# Base de datos PostgreSQL
DB_URL=jdbc:postgresql://postgres:5432/logitrack_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
PORT=8081

# Configuración de Correo Gmail SMTP (Notificaciones de Bienvenida por Rol)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=tu_correo@gmail.com
SPRING_MAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx
APP_MAIL_ENABLED=true
APP_MAIL_FROM=no-reply@logitrack.com

